model ResearchFollowUp {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedResearchId      String? @map("feed_research_id") @db.Uuid
  analysisId          String? @map("analysis_id") @db.Uuid
  horizonSessions     Int @map("horizon_sessions")
  methodologyVersion  String @map("methodology_version")
  status              String @default("pending")
  reason              String @default("AWAITING_REFERENCE")
  referenceSnapshotId String? @map("reference_snapshot_id") @db.Uuid
  observedSnapshotId  String? @map("observed_snapshot_id") @db.Uuid
  dueAt               DateTime? @map("due_at") @db.Timestamptz(6)
  referenceAt         DateTime? @map("reference_at") @db.Timestamptz(6)
  observedAt          DateTime? @map("observed_at") @db.Timestamptz(6)
  referencePrice      Decimal? @map("reference_price") @db.Decimal(38,18)
  observedPrice       Decimal? @map("observed_price") @db.Decimal(38,18)
  changePct           Decimal? @map("change_pct") @db.Decimal(18,8)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  feedResearch        FeedResearch? @relation(fields: [feedResearchId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "followup_research_fk")
  analysis            Analysis? @relation(fields: [analysisId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "followup_analysis_fk")
  referenceSnapshot   MarketSnapshotRecord? @relation("followup_reference", fields: [referenceSnapshotId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "followup_reference_fk")
  observedSnapshot    MarketSnapshotRecord? @relation("followup_observed", fields: [observedSnapshotId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "followup_observed_fk")

  @@unique([feedResearchId, horizonSessions, methodologyVersion], map: "followup_research_unique")
  @@unique([analysisId, horizonSessions, methodologyVersion], map: "followup_analysis_unique")
  @@index([status, updatedAt], map: "followup_pending_idx")
  @@map("research_followups")
}

