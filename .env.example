# Local development only. Replace these credentials before hosting.
DATABASE_URL=postgresql://swing:swing_local@127.0.0.1:5434/swing
POSTGRES_USER=swing
POSTGRES_PASSWORD=swing_local
POSTGRES_DB=swing
POSTGRES_PORT=5434
WORKER_HOST=127.0.0.1
WORKER_PORT=3001
WORKER_HEALTH_URL=http://127.0.0.1:3001
WORKER_HEARTBEAT_MS=10000
WORKER_JOB_POLL_MS=2000
# Optional override for the same NSE announcement RSS source (HTTPS only).
# NSE_ANNOUNCEMENTS_URL=https://nsearchives.nseindia.com/content/RSS/Online_announcements.xml
# Optional announcement research. Add a real key securely in your environment;
# do not commit it. AI is only invoked by announcements:analyze, not ingestion.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
