# Local development only. Replace these credentials before hosting.
DATABASE_URL=postgresql://swing:swing_local@127.0.0.1:5434/swing
POSTGRES_USER=swing
POSTGRES_PASSWORD=swing_local
POSTGRES_DB=swing
POSTGRES_PORT=5434
WORKER_HOST=127.0.0.1
WORKER_PORT=3001
WORKER_HEALTH_URL=http://127.0.0.1:3001
WORKER_HEARTBEAT_MS=10000
WORKER_JOB_POLL_MS=2000
# Local maintained calendar based on official NSE equity notices; no default file.
# MARKET_CALENDAR_FILE=/absolute/path/to/market-calendar.json
# Enable only after supplying a maintained calendar and feed network access.
WORKER_SCHEDULER_ENABLED=false
WORKER_SCHEDULER_TICK_MS=10000
# AI in scheduled pipelines is separately opt-in and can consume paid quota.
WORKER_SCHEDULER_AI_ENABLED=false
WORKER_SCHEDULER_AI_LIMIT=1
# Generate a stored 08:45 IST briefing on known trading days (no delivery).
WORKER_MORNING_BRIEFING_ENABLED=false
# Generate a preliminary 15:45 IST summary (later after special-session closes).
WORKER_CLOSING_BRIEFING_ENABLED=false
# Reassess the saved morning watchlist 5–15 minutes after opening; no trading.
WORKER_POSTOPEN_ENABLED=false
# Optional override for the same NSE announcement RSS source (HTTPS only).
# NSE_ANNOUNCEMENTS_URL=https://nsearchives.nseindia.com/content/RSS/Online_announcements.xml
# Optional announcement research. Add a real key securely in your environment;
# do not commit it. AI runs only through explicit research or opted-in AI jobs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Price collection remains opt-in until provider coverage and timestamps are verified.
# Requires WORKER_SCHEDULER_ENABLED and a maintained calendar. Empty symbols selects the complete imported active universe.
WORKER_PRICES_ENABLED=false
WORKER_PRICE_SYMBOLS=
WORKER_PRICE_HISTORY_DAYS=7

# Optional native PostgreSQL archive tooling; choose a private persistent disk.
# SWING_BACKUP_DIR=/absolute/private/path/swing-backups
# Restore is explicit and requires a separate, empty database.
# RESTORE_DATABASE_URL=postgresql://user:password@host:5432/swing_restore

# Hourly follow-ups from stored observations only; no new provider/AI calls.
WORKER_FOLLOWUPS_ENABLED=false

# Required even locally. Use independent random secrets; TLS is required when hosted.
SWING_AUTH_USER=owner
SWING_AUTH_PASSWORD=
WORKER_ACCESS_TOKEN=
# Exact browser-facing origin, especially behind a reverse proxy:
SWING_PUBLIC_ORIGIN=http://localhost:3000

# Empty symbols selects the complete imported active universe (including indexes).
# Round-robin, bounded per configured slot; full coverage cadence depends on batch.
WORKER_PRICE_SLOT_MS=300000
WORKER_PRICE_BATCH_SIZE=20
WORKER_PRICE_REQUEST_INTERVAL_MS=1000
MARKET_DATA_PROVIDER=yahoo-experimental
