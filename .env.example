# Local development only. Replace these credentials before hosting.
DATABASE_URL=postgresql://swing:swing_local@127.0.0.1:5434/swing
POSTGRES_USER=swing
POSTGRES_PASSWORD=swing_local
POSTGRES_DB=swing
POSTGRES_PORT=5434
WORKER_HOST=127.0.0.1
WORKER_PORT=3001
WORKER_HEALTH_URL=http://127.0.0.1:3001
WORKER_HEARTBEAT_MS=10000
WORKER_JOB_POLL_MS=2000
# Local maintained calendar based on official NSE equity notices; no default file.
# MARKET_CALENDAR_FILE=/absolute/path/to/market-calendar.json
# Enable only after supplying a maintained calendar and feed network access.
WORKER_SCHEDULER_ENABLED=false
WORKER_SCHEDULER_TICK_MS=10000
# AI in scheduled pipelines is separately opt-in and can consume paid quota.
WORKER_SCHEDULER_AI_ENABLED=false
WORKER_SCHEDULER_AI_LIMIT=1
# Optional override for the same NSE announcement RSS source (HTTPS only).
# NSE_ANNOUNCEMENTS_URL=https://nsearchives.nseindia.com/content/RSS/Online_announcements.xml
# Optional announcement research. Add a real key securely in your environment;
# do not commit it. AI runs only through explicit research or opted-in AI jobs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
