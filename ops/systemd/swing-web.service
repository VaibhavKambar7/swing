[Unit]
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=6

[Service]
User=swing
Group=swing
Environment=NODE_ENV=production
Environment=PATH=/opt/node24/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/swing/swing.env
WorkingDirectory=/opt/swing/current
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/swing
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ReadWritePaths=/opt/swing/current/.next/standalone/.next/cache
ExecStart=/opt/node24/bin/node /opt/swing/current/.next/standalone/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
