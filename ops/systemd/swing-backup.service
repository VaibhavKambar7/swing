[Unit]
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=6

[Service]
User=swing
Group=swing
Environment=NODE_ENV=production
Environment=PATH=/opt/node24/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/swing/swing.env
WorkingDirectory=/opt/swing/current
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/swing
Type=oneshot
ExecStart=/opt/node24/bin/node --import tsx scripts/backup-db.ts
TimeoutStartSec=15min
