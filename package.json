{
  "name": "swing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "worker:dev": "node --use-env-proxy --import tsx --watch src/workers/index.ts",
    "worker": "node --use-env-proxy --import tsx src/workers/index.ts",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "db:check": "tsx scripts/check-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:studio": "prisma studio",
    "announcements:fetch": "node --use-env-proxy --import tsx scripts/ingest-announcements.ts",
    "universe:seed": "tsx scripts/seed-universe.ts",
    "announcements:match": "tsx scripts/match-announcements.ts",
    "announcements:filter": "tsx scripts/filter-announcements.ts",
    "announcements:check": "node --use-env-proxy --import tsx scripts/ingest-announcements.ts --dry-run",
    "announcements:analyze": "node --use-env-proxy --import tsx scripts/analyze-announcements.ts",
    "jobs:enqueue": "tsx scripts/enqueue-job.ts",
    "market:check": "tsx scripts/check-market.ts",
    "jobs:status": "tsx scripts/check-jobs.ts",
    "prices:check": "node --use-env-proxy --import tsx scripts/check-prices.ts"
  },
  "dependencies": {
    "@next/env": "^16.4.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fast-xml-parser": "5.11.2",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "0.2.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
